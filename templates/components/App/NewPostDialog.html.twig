<twig:Dialog id="new-post">
    <twig:Dialog:Trigger>
        <twig:Button {{ ...dialog_trigger_attrs }}>
            <twig:ux:icon name="lucide:plus" data-icon="inline-start" />
            New post
        </twig:Button>
    </twig:Dialog:Trigger>
    <twig:Dialog:Content class="sm:max-w-lg">
        <twig:Dialog:Header>
            <twig:Dialog:Title>New post</twig:Dialog:Title>
            <twig:Dialog:Description>Each field is checked as soon as you leave it.</twig:Dialog:Description>
        </twig:Dialog:Header>
        <twig:App:PostForm />
    </twig:Dialog:Content>
</twig:Dialog>
