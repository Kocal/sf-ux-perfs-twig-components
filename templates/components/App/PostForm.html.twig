{% form_theme form 'form/shadcn.html.twig' %}
<div {{ attributes }}>
    {{ form_start(form, {attr: {novalidate: true, class: 'flex flex-col gap-4', 'data-action': 'live#action:prevent', 'data-live-action-param': 'save'}}) }}
        {{ form_row(form.title) }}
        {{ form_row(form.excerpt) }}
        <div class="grid grid-cols-2 gap-4">
            {{ form_row(form.author) }}
            {{ form_row(form.category) }}
        </div>
        {{ form_row(form.status) }}
        {% if form.status.vars.value == 'scheduled' %}
            {{ form_row(form.publishedAt) }}
        {% endif %}
        {{ form_row(form.tags) }}
        <div class="grid grid-cols-2 items-end gap-4">
            {{ form_row(form.readingTime) }}
            {{ form_row(form.featured) }}
        </div>
        <div class="flex justify-end gap-2">
            <twig:Button type="submit" data-loading="addAttribute(disabled)">
                <twig:ux:icon name="lucide:loader-circle" data-icon="inline-start" class="animate-spin" data-loading="show" />
                {{ initialFormData ? 'Save changes' : 'Create post' }}
            </twig:Button>
        </div>
    {{ form_end(form, {render_rest: false}) }}
</div>
